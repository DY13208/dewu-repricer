DB_PASSWORD=请修改
REPRICER_DRY_RUN=true
REPRICER_CRON=0 */10 * * * ?
# 凭据加密密钥：openssl rand -base64 32（丢失后已存凭据无法解密）
REPRICER_CRYPTO_KEY=
# 得物开放平台：SANDBOX / PROD
DEWU_ENV=SANDBOX
# 仅 ISV 模式需要；自研商家应用的 app_key/app_secret 在后台按店铺录入（加密存库）
DEWU_ISV_APP_KEY=
DEWU_ISV_APP_SECRET=
# 已获批权限包：BIDDING_READ,BIDDING_WRITE,AUTO_BIDDING,LOWEST_PRICE
DEWU_GRANTED_PACKS=
DEWU_LOWEST_PRICE_ENABLED=false
DEWU_RATE_PER_MINUTE=1000
DEWU_RATE_PER_DAY=20000
